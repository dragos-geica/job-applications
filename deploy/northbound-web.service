[Unit]
Description=Northbound private internship tracker
After=network-online.target
[Service]
User=northbound
WorkingDirectory=/srv/northbound
Environment=DATABASE_PATH=/srv/northbound/data/tracker.sqlite3
Environment=COOKIE_SECURE=1
ExecStart=/srv/northbound/.venv/bin/python app.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/northbound/data
[Install]
WantedBy=multi-user.target
